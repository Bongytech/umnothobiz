# Firebase web app configuration.
# Copy this file to .env.local and paste the values from:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
#
# These values identify the project; they are not server secrets. Access is
# controlled by Firebase Authentication and firestore.rules. Still, keep
# environment files out of git so each environment can use its own project.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-ABC123DEF

# Set to true only when running the Firebase emulators locally.
VITE_USE_FIREBASE_EMULATORS=false

# Optional: Firebase App Check (reCAPTCHA Enterprise) site key.
# Required in the browser when Functions use ENFORCE_APP_CHECK=true.
VITE_RECAPTCHA_SITE_KEY=
