# Local Functions emulator settings for the crypto sandbox.
# Copy to functions/.env.local. Never commit that file or reuse these values in
# production.

CRYPTO_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=true
SANDBOX_ZAR_PER_USDT=18.50
SANDBOX_USDT_ADDRESS=0x0000000000000000000000000000000000000000
SANDBOX_NETWORK=Base Sepolia testnet
SANDBOX_WEBHOOK_SECRET=local-only-change-me

# ---------------------------------------------------------------------------
# Production settings. Use functions/.env.<project-id> or the Firebase console.
#
# Two ways to provide the NOWPayments credentials:
#   A. Secret Manager (recommended): enable the Secret Manager API, set
#      USE_SECRET_MANAGER=true, then:
#        firebase functions:secrets:set NOWPAYMENTS_API_KEY
#        firebase functions:secrets:set NOWPAYMENTS_IPN_SECRET
#   B. Environment-variable fallback: leave USE_SECRET_MANAGER unset/false
#      and put the two values below in functions/.env.<project-id>. This is for
#      local/staging only; the deployed production provider refuses it. Never
#      commit that file.
# ---------------------------------------------------------------------------
# USE_SECRET_MANAGER=false
# CRYPTO_PROVIDER=nowpayments
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# NOWPAYMENTS_API_KEY=your_key_here
# NOWPAYMENTS_IPN_SECRET=your_ipn_secret_here
# CRYPTO_WEBHOOK_URL=https://us-central1-umnotho-f71ba.cloudfunctions.net/cryptoWebhook
# APP_URL=https://umnothobiz.web.app
# REQUIRE_VERIFIED_EMAIL=true
# ENFORCE_APP_CHECK=true
