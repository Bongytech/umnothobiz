{
  "name": "umnotho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-umnotho \"node node_modules/vitest/vitest.mjs run --config vitest.rules.config.ts\"",
    "security": "npm run lint && npm audit --omit=dev --audit-level=high",
    "security:all": "npm run lint && npm audit --audit-level=high",
    "security:report": "node scripts/security-monitor.js",
    "deploy": "npm run build && npx --yes firebase-tools@15 deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-security-node": "^1.1.4",
    "globals": "^15.11.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.1",
    "vitest": "^4.0.16"
  }
}
